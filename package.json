    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
