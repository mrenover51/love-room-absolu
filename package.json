  "private": true,
  "scripts": {
    "prebuild": "npm run validate:schema && npm run validate:mesh && npm run seo:audit && npm run performance:audit",
    "validate:schema": "node scripts/validate-structured-data.mjs",
    "validate:mesh": "node scripts/validate-internal-mesh.mjs",
    "performance:audit": "node scripts/performance-audit.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npx tsc --noEmit && npm test && npm run audit:release",
